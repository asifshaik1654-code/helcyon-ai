# ==============================================================================
# HELCYON AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT:
# 1. Never commit real credentials or .env files to Git.
# 2. Duplicate this file as .env in root or corresponding client/server folders.
# 3. For development, a full DEMO MODE with synthetic data is available out of the box!
# ==============================================================================

# Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase (Database & Authentication)
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI
# Obtain this from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your-gemini-api-key

# Client Environment Variables (Vite requires VITE_ prefix for client-exposed variables)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=http://localhost:5000/api

